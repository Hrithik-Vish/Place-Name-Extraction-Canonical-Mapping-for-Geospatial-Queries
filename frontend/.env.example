# Base URL of the running backend's FastAPI server (see ../backend/main.py).
# App.jsx falls back to http://localhost:8000 if this isn't set, so this
# only needs to be set explicitly when the backend runs somewhere else
# (a deployed API, a different port, Docker, etc).
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
VITE_API_BASE_URL=http://localhost:8000
